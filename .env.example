# Senha única do painel (sem login nesta versão)
VPS_ADMIN_PASSWORD=troque-esta-senha
# Chave das URLs assinadas de mídia: openssl rand -base64 32
VPS_SIGNING_KEY=

# URL pública (links curtos /l/... e busca visual do Google Lens usam este endereço)
PUBLIC_BASE_URL=http://localhost:8080

# IA que identifica os produtos nos quadros: gemini | deepseek
VPS_AI_PROVIDER=gemini
VPS_AI_GEMINI_API_KEY=
VPS_AI_DEEPSEEK_API_KEY=
# "deepseek" aceita outro provedor compatível com a API da OpenAI (parte da URL antes de /chat/completions).
# Ex.: https://openrouter.ai/api/v1 com o modelo deepseek/deepseek-chat, ou http://ollama:11434/v1 (sem chave)
VPS_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
VPS_AI_DEEPSEEK_MODEL=deepseek-flash

# Busca nas lojas: serpapi | brave | deepseek
VPS_SEARCH_PROVIDER=serpapi
# Busca deepseek: vazio herda da análise. Precisa de um provedor com a ferramenta deepseek_web_search (a API oficial tem).
# A chave da análise só é reaproveitada quando a busca vai para o mesmo host.
VPS_SEARCH_DEEPSEEK_BASE_URL=
VPS_SEARCH_DEEPSEEK_MODEL=
VPS_SEARCH_DEEPSEEK_API_KEY=
VPS_SEARCH_SERPAPI_KEY=
VPS_SEARCH_BRAVE_KEY=

# Modelo do whisper.cpp embutido na imagem: tiny | base | small (maior = melhor e mais lento)
WHISPER_MODEL=base
