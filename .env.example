# Senha única do painel (sem login nesta versão)
VPS_ADMIN_PASSWORD=troque-esta-senha
# Chave das URLs assinadas de mídia: openssl rand -base64 32
VPS_SIGNING_KEY=

# URL pública (links curtos /l/... e busca visual do Google Lens usam este endereço)
PUBLIC_BASE_URL=http://localhost:8080

# IA que identifica os produtos nos quadros: gemini | deepseek
VPS_AI_PROVIDER=gemini
VPS_AI_GEMINI_API_KEY=
VPS_AI_DEEPSEEK_API_KEY=

# Busca nas lojas: serpapi | brave | deepseek  (deepseek usa a mesma chave VPS_AI_DEEPSEEK_API_KEY)
VPS_SEARCH_PROVIDER=serpapi
VPS_SEARCH_SERPAPI_KEY=
VPS_SEARCH_BRAVE_KEY=

# Modelo do whisper.cpp embutido na imagem: tiny | base | small (maior = melhor e mais lento)
WHISPER_MODEL=base
